{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist-types",
    "tsBuildInfoFile": "./dist-types/.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/transport"
    },
    {
      "path": "../../packages/engine"
    },
    {
      "path": "../../packages/ui"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
